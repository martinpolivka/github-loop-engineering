{
  "id": "sandbox",
  "label": "Public GitHub sandbox",
  "githubHost": "github.com",
  "owner": "workshop-owner",
  "authoringRepository": "github-loop-engineering",
  "repositoryPrefix": "workshop-lab",
  "visibility": "private",
  "stationMode": "local-or-per-team",
  "allowRemoteProvision": true,
  "allowRemoteSeed": true,
  "allowRemoteDelete": false,
  "capabilities": {
    "agenticWorkflows": "preview-check",
    "copilotCloudAgent": "account-check",
    "thirdPartyCodingAgents": "account-check",
    "organizationRulesets": "demonstration",
    "enterprisePolicies": "simulation",
    "codeQuality": "demonstration-unless-enabled",
    "codeSecurity": "public-repository-or-license",
    "secretProtection": "public-repository-or-license",
    "environments": "repository-check"
  }
}
