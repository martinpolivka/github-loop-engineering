{
  "name": "github-loop-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm --prefix demo-app start",
    "test": "npm --prefix demo-app test",
    "test:materials": "node --test --test-concurrency=1 \"workshop/tests/*.test.mjs\"",
    "validate": "node workshop/tools/materials/validate-content.mjs",
    "validate:workflows": "gh aw validate documentation-review goal-review repository-pulse showcase-signal --strict",
    "compile:workflows": "gh aw compile documentation-review goal-review repository-pulse showcase-signal --schedule-seed workshop/github-loop-engineering --validate",
    "preflight": "node workshop/tools/preflight/preflight.mjs --profile sandbox",
    "test:browser": "node workshop/tools/materials/browser.mjs",
    "validate:html": "node workshop/tools/materials/html-docs.mjs",
    "capture": "node workshop/tools/materials/browser.mjs --capture",
    "serve": "node workshop/tools/materials/serve.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
